		font-size: 1.05rem;
		max-width: 60ch;
	}

	.recalc {
		border-top: 1px solid var(--line);
		padding-block: 2.5rem 3rem;
	}

	.recalc h2 {
		font-size: 1.6rem;
		margin: 0 0 1.5rem;
	}
</style>
