---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeachScene from '../components/BeachScene.astro';

const directory = [
	{ href: '/about', label: 'About Me', sub: 'Where it started' },
	{ href: '/experience', label: 'Experience', sub: 'What I’ve done so far' },
	{ href: '/leadership', label: 'Leadership', sub: 'Execution under pressure' },
	{ href: '/research', label: 'Investment Research', sub: 'Finding what the market may be missing' },
	{ href: '/investment-banking', label: 'Investment Banking', sub: 'Where I want to go next' },
	{ href: '/journal', label: 'The Journal', sub: 'Off the clock' },
];
---

<BaseLayout
	title="From the Gulf Coast to Wall Street"
	description="Hayden Smith, Carnegie Mellon University, Business Administration. From Florida to finance."
	fullBleed
	transparentNav
	showConnect={false}
	dark={false}
>
	<BeachScene />

	<section class="directory wrap-wide">
		<p class="eyebrow">Find your way in</p>
		<h2>Every object on the shore is a door.</h2>
		<p class="now">
			I'm a Business Administration student at Carnegie Mellon's Tepper School, finance concentration with an additional major in statistics, class of 2029. I cover TMT names for the Tartan Student Fund and I'm recruiting for investment banking internships.
		</p>
		<div class="grid">
			{
				directory.map((d) => (
					<a class="card" href={d.href}>
						<span class="card-label">{d.label}</span>
						<span class="card-sub">{d.sub}</span>
						<span class="arrow" aria-hidden="true">&rarr;</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="footer-connect wrap-wide">
		<p class="eyebrow">Connect</p>
		<ul>
			<li><a href="https://www.linkedin.com/in/hayden-smith29" target="_blank" rel="noopener">LinkedIn <span>in/hayden-smith29</span> &rarr;</a></li>
			<li><a href="mailto:haydensmith8923@gmail.com">Email <span>haydensmith8923@gmail.com</span> &rarr;</a></li>
			<li><a href="/resume">Résumé <span>View PDF</span> &rarr;</a></li>
		</ul>
	</section>
</BaseLayout>

<style>
	.directory {
		padding-block: 5rem 4rem;
		background: var(--off-white);
	}

	h2 {
		max-width: 26ch;
		margin-bottom: 1.2rem;
	}

	.now {
		max-width: 60ch;
		margin: 0 0 2.5rem;
		font-size: 0.98rem;
		color: var(--ocean);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1px;
		background: var(--line);
		border: 1px solid var(--line);
	}

	.card {
		background: var(--off-white);
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.8rem;
		text-decoration: none;
		color: var(--navy-deep);
		position: relative;
		transition: background 0.25s ease;
	}

	.card:hover {
		background: var(--sand);
	}

	.card-label {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.25rem;
	}

	.card-sub {
		font-size: 0.85rem;
		color: var(--ocean);
	}

	.arrow {
		position: absolute;
		top: 1.8rem;
		right: 1.8rem;
		color: var(--sunset);
		transition: transform 0.25s ease;
	}

	.card:hover .arrow {
		transform: translateX(4px);
	}

	.footer-connect {
		padding-block: 3rem 4rem;
		border-top: 1px solid var(--line);
	}

	.footer-connect ul {
		list-style: none;
		padding: 0;
		margin: 1.2rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
	}

	.footer-connect a {
		text-decoration: none;
		color: var(--navy-deep);
		font-weight: 600;
		font-size: 0.95rem;
	}

	.footer-connect a span {
		color: var(--ocean);
		font-weight: 500;
		margin-left: 0.3em;
	}
</style>
