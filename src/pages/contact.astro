---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
	{ label: 'Email', value: 'you@example.com', href: 'mailto:you@example.com' },
	{ label: 'GitHub', value: 'github.com/haydensmith8923', href: 'https://github.com/haydensmith8923' },
	{ label: 'LinkedIn', value: 'linkedin.com/in/haydensmith', href: 'https://linkedin.com/in/haydensmith' },
];
---

<BaseLayout title="Contact" description="Get in touch.">
	<section class="wrap intro">
		<p class="eyebrow">Contact</p>
		<h1>Say hi</h1>
		<p class="sub">Best way to reach me is email. Replace these placeholders with your real handles.</p>
	</section>

	<section class="wrap">
		<ul class="link-list">
			{
				links.map((link) => (
					<li>
						<a href={link.href}>
							<span class="label">{link.label}</span>
							<span class="value">{link.value} &rarr;</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.intro {
		padding-block: 2rem 2.5rem;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--moss);
		margin-bottom: 1rem;
	}

	.sub {
		font-size: 1.1rem;
		color: color-mix(in srgb, var(--ink) 80%, transparent);
		max-width: 42ch;
	}

	.link-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.link-list li {
		border-top: 1px solid var(--line);
	}

	.link-list li:last-child {
		border-bottom: 1px solid var(--line);
	}

	.link-list a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		text-decoration: none;
		color: var(--ink);
		padding: 1.4rem 0;
		transition: color 0.2s ease, padding-left 0.2s ease;
	}

	.link-list a:hover {
		color: var(--rust-dark);
		padding-left: 0.5rem;
	}

	.label {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.3rem;
	}

	.value {
		font-size: 0.95rem;
		color: color-mix(in srgb, var(--ink) 65%, transparent);
	}
</style>
