---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
---

<BaseLayout title="About" description="How I got here — the personal story.">
	<section class="wrap intro">
		<p class="eyebrow">About</p>
		<h1>How I got here</h1>
		<p class="sub">The short version is on this page. The long version is still being written — scroll for the milestones that actually mattered.</p>
	</section>

	<section class="wrap">
		<Timeline />
	</section>
</BaseLayout>

<style>
	.intro {
		padding-block: 2rem 2.5rem;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--moss);
		margin-bottom: 1rem;
	}

	.sub {
		font-size: 1.1rem;
		color: color-mix(in srgb, var(--ink) 80%, transparent);
		max-width: 42ch;
	}
</style>
