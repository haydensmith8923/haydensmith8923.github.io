---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Connect from '../components/Connect.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	fullBleed?: boolean;
	transparentNav?: boolean;
	showConnect?: boolean;
	dark?: boolean;
}

const {
	title,
	description = 'Hayden Smith — from the Gulf Coast to Wall Street.',
	fullBleed = false,
	transparentNav = false,
	showConnect = true,
	dark = true,
} = Astro.props;
---

<html lang="en" data-theme={dark ? 'dark' : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<Nav transparent={transparentNav} />
		<main class:list={{ 'full-bleed': fullBleed }}>
			<slot />
		</main>
		{showConnect && <Connect />}
		<footer>
			<div class="wrap-wide">
				<p>&copy; {new Date().getFullYear()} Hayden Smith.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	main {
		min-height: 60vh;
		padding-block: 3.5rem 2rem;
	}

	main.full-bleed {
		padding: 0;
		min-height: 0;
	}

	footer {
		border-top: 1px solid var(--line);
		padding-block: 1.5rem;
		font-size: 0.78rem;
		color: color-mix(in srgb, var(--fg) 55%, transparent);
	}

	footer p {
		margin: 0;
	}
</style>
