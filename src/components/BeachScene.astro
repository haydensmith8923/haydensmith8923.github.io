---
// Positions/sizes/rotations were hand-tuned against the actual hero photo's
// rock and shoreline geometry (see the composed reference render) so each
// object sits on real open sand at a plausible distance/scale, not a row.
const spots = [
	{
		id: 'tower',
		href: '/leadership',
		name: 'Lifeguard Tower',
		label: 'Leadership',
		sub: 'Execution under pressure',
		left: 15,
		bottom: 30,
		width: 16.5,
		rotate: 0,
	},
	{
		id: 'chair',
		href: '/about',
		name: 'Beach Chair',
		label: 'About Me',
		sub: 'Where it started',
		left: 64,
		bottom: 19,
		width: 10,
		rotate: 0,
	},
	{
		id: 'suitcase',
		href: '/investment-banking',
		name: 'Suitcase',
		label: 'Investment Banking',
		sub: 'Where I want to go next',
		left: 74,
		bottom: 15,
		width: 6,
		rotate: -4,
	},
	{
		id: 'notebook',
		href: '/journal',
		name: 'Notebook',
		label: 'My Journal',
		sub: 'Notes in progress',
		left: 80,
		bottom: 11,
		width: 4.2,
		rotate: 8,
	},
	{
		id: 'surfboard',
		href: '/experience',
		name: 'Surfboard',
		label: 'Experience',
		sub: 'What I’ve done so far',
		left: 88,
		bottom: 38,
		width: 3.4,
		rotate: 40,
	},
];

// Decorative only (not a hotspot) — sits beneath the suitcase/notebook.
const blanket = { left: 77, bottom: 9, width: 17 };
---

<section class="scene" data-scene aria-label="Interactive beach photo — explore the site through objects on the shore">
	<picture class="bg-photo">
		<source media="(max-width: 780px)" srcset="/images/beach-hero-mobile.webp" />
		<img
			src="/images/beach-hero.webp"
			alt="Sunset over the ocean, waves rolling onto an open sand beach"
			fetchpriority="high"
		/>
	</picture>
	<div class="scrim" aria-hidden="true"></div>

	<button class="hotspot shore-hotspot" data-hotspot aria-label="The shore">
		<span class="tooltip">
			<strong>The Shore</strong>
			<em>Every path on this beach starts here.</em>
		</span>
	</button>

	<svg class="footprints" viewBox="0 0 90 140" preserveAspectRatio="xMidYMax meet" data-footprints aria-hidden="true">
		<g fill="currentColor" opacity="0.55">
			<ellipse cx="30" cy="128" rx="6" ry="10" />
			<ellipse cx="48" cy="104" rx="6" ry="10" />
			<ellipse cx="32" cy="80" rx="6" ry="10" />
			<ellipse cx="50" cy="56" rx="6" ry="10" />
			<ellipse cx="34" cy="32" rx="6" ry="10" />
			<ellipse cx="52" cy="8" rx="6" ry="10" />
		</g>
	</svg>

	<img
		class="blanket"
		src="/images/objects/blanket.webp"
		alt=""
		aria-hidden="true"
		style={`left:${blanket.left}%; bottom:${blanket.bottom}%; width:${blanket.width}%;`}
	/>

	{
		spots.map((s) => (
			<a
				class={`hotspot object object-${s.id}`}
				data-hotspot
				href={s.href}
				style={`left:${s.left}%; bottom:${s.bottom}%; width:${s.width}%;`}
				aria-label={`${s.name}: ${s.label} — ${s.sub}`}
			>
				<span class="obj-shadow" aria-hidden="true" />
				<img class="obj-img" style={`--rot:${s.rotate}deg;`} src={`/images/objects/${s.id}.webp`} alt="" loading="eager" />
				<span class="tooltip">
					<strong>{s.label}</strong>
					<em>{s.sub}</em>
					<span class="open">Open &rarr;</span>
				</span>
			</a>
		))
	}

	<button class="easter sun-easter" data-easter="sun" aria-label="The sunset" style="left:62%; top:37%;"></button>

	<div class="hero-copy">
		<p class="kicker">From the Gulf Coast to Wall Street</p>
		<h1>HAYDEN SMITH</h1>
		<p class="sub">Carnegie Mellon University &middot; Business Administration</p>
		<p class="hint" data-hint>Explore the shore to begin.</p>
	</div>

	<div class="easter-popover" data-easter-popover hidden>
		<button class="close" data-easter-close aria-label="Close">&times;</button>
		<p data-easter-text></p>
	</div>
</section>

<script define:vars={{
	sunText: "“Good days and bad days can happen simultaneously. Show up for both.”",
}}>
	const popover = document.querySelector('[data-easter-popover]');
	const popoverText = document.querySelector('[data-easter-text]');
	const closeBtn = document.querySelector('[data-easter-close]');
	const hint = document.querySelector('[data-hint]');

	const texts = { sun: sunText };

	document.querySelectorAll('[data-easter]').forEach((el) => {
		el.addEventListener('click', () => {
			const key = el.getAttribute('data-easter');
			if (!popover || !popoverText) return;
			popoverText.textContent = texts[key] || '';
			popover.hidden = false;
		});
	});

	closeBtn?.addEventListener('click', () => {
		if (popover) popover.hidden = true;
	});

	let hovered = false;
	document.querySelectorAll('[data-hotspot]').forEach((el) => {
		el.addEventListener('mouseenter', () => {
			if (!hovered) {
				hovered = true;
				hint?.classList.add('is-hidden');
			}
		});
	});
</script>

<style>
	.scene {
		position: relative;
		width: 100%;
		height: 100svh;
		min-height: 560px;
		overflow: hidden;
		background: var(--navy-deep);
	}

	.bg-photo,
	.bg-photo img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.bg-photo img {
		object-fit: cover;
		object-position: center 60%;
	}

	.scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(8, 14, 24, 0.6) 0%,
			rgba(8, 14, 24, 0.18) 26%,
			rgba(8, 14, 24, 0.02) 46%,
			rgba(8, 14, 24, 0.16) 72%,
			rgba(8, 14, 24, 0.5) 100%
		);
	}

	.shore-hotspot {
		position: absolute;
		left: 0;
		right: 0;
		top: 58%;
		bottom: 0;
		background: none;
		border: none;
		cursor: default;
		padding: 0;
		z-index: 1;
	}

	.shore-hotspot .tooltip {
		left: 50%;
		bottom: auto;
		top: 30%;
		transform: translate(-50%, -40%);
	}

	.shore-hotspot:hover .tooltip,
	.shore-hotspot:focus-visible .tooltip {
		transform: translate(-50%, -50%);
	}

	.blanket {
		position: absolute;
		display: block;
		height: auto;
		transform: translateX(-50%);
		z-index: 1;
		pointer-events: none;
	}

	.footprints {
		position: absolute;
		left: 60%;
		bottom: 0;
		width: 13%;
		height: 30%;
		color: var(--wood);
		z-index: 2;
	}

	.hotspot {
		position: absolute;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: var(--off-white);
		transition: transform 0.35s var(--ease);
		text-decoration: none;
		z-index: 3;
	}

	.hotspot.object {
		transform: translateX(-50%);
	}

	.obj-img {
		display: block;
		width: 100%;
		height: auto;
		transform: rotate(var(--rot, 0deg));
		transform-origin: 50% 85%;
		transition: transform 0.2s ease, filter 0.2s ease;
		filter: drop-shadow(0 1px 1px rgba(8, 14, 24, 0.25));
	}

	.object-surfboard .obj-shadow {
		display: none;
	}

	.obj-shadow {
		position: absolute;
		left: 50%;
		bottom: -6%;
		width: 78%;
		height: 20%;
		transform: translateX(-50%);
		background: radial-gradient(ellipse at center, rgba(5, 8, 14, 0.45) 0%, rgba(5, 8, 14, 0) 72%);
		filter: blur(2px);
		pointer-events: none;
		z-index: -1;
		transition: opacity 0.2s ease;
	}

	.hotspot.object:hover .obj-img,
	.hotspot.object:focus-visible .obj-img {
		transform: rotate(var(--rot, 0deg)) scale(1.035) translateY(-2px);
		filter: drop-shadow(0 3px 4px rgba(8, 14, 24, 0.3)) brightness(1.08);
	}

	.hotspot.object:hover .obj-shadow,
	.hotspot.object:focus-visible .obj-shadow {
		opacity: 0.7;
	}

	.hotspot:focus-visible {
		outline: 1px solid rgba(250, 247, 240, 0.8);
		outline-offset: 3px;
	}

	.tooltip {
		position: absolute;
		left: 50%;
		bottom: calc(100% + 12px);
		transform: translate(-50%, 6px);
		background: rgba(11, 31, 51, 0.94);
		color: var(--off-white);
		padding: 0.7rem 1rem;
		min-width: 172px;
		text-align: left;
		font-family: var(--font-body);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease, transform 0.25s ease;
		white-space: nowrap;
	}

	.tooltip strong {
		display: block;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 600;
		margin-bottom: 0.15rem;
	}

	.tooltip em {
		display: block;
		font-style: normal;
		font-size: 0.72rem;
		color: var(--sand);
		letter-spacing: 0.02em;
	}

	.tooltip .open {
		display: block;
		margin-top: 0.4rem;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sunset);
	}

	.hotspot:hover .tooltip,
	.hotspot:focus-visible .tooltip {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.easter {
		position: absolute;
		background: none;
		border: none;
		cursor: pointer;
		color: rgba(250, 247, 240, 0.75);
		z-index: 3;
		min-width: 44px;
		min-height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.easter:hover {
		color: var(--sunset);
	}

	.sun-easter {
		width: 90px;
		height: 90px;
		border-radius: 50%;
		transform: translate(-50%, -50%);
		min-width: 0;
		min-height: 0;
	}

	.hero-copy {
		position: absolute;
		left: 50%;
		top: 30%;
		transform: translate(-50%, -50%);
		text-align: center;
		color: var(--off-white);
		z-index: 4;
		width: 100%;
		padding: 0 1.5rem;
	}

	.kicker {
		text-transform: uppercase;
		letter-spacing: 0.22em;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--sand);
		margin: 0 0 1.1rem;
	}

	.hero-copy h1 {
		font-size: clamp(2.4rem, 8vw, 5rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		margin: 0 0 0.5rem;
		text-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
	}

	.sub {
		font-size: clamp(0.95rem, 2vw, 1.15rem);
		color: var(--off-white);
		margin: 0 0 0.4rem;
		font-weight: 500;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
	}

	.tag {
		font-family: var(--font-display);
		font-style: italic;
		font-size: clamp(1rem, 2.2vw, 1.25rem);
		color: var(--sand);
		margin: 0;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
	}

	.hint {
		margin: 2.2rem 0 0;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: rgba(250, 247, 240, 0.75);
		transition: opacity 0.4s ease;
	}

	.hint.is-hidden {
		opacity: 0;
	}

	.easter-popover {
		position: absolute;
		left: 50%;
		bottom: 8%;
		transform: translateX(-50%);
		max-width: 360px;
		background: var(--off-white);
		color: var(--navy-deep);
		padding: 1.2rem 1.4rem;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
		z-index: 10;
	}

	.easter-popover p {
		margin: 0;
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1rem;
		padding-right: 1.2rem;
	}

	.easter-popover .close {
		position: absolute;
		top: 0.4rem;
		right: 0.6rem;
		background: none;
		border: none;
		font-size: 1.2rem;
		cursor: pointer;
		color: var(--navy-deep);
	}

	@media (max-width: 780px) {
		.scene {
			height: 70vh;
			min-height: 420px;
		}

		.shore-hotspot,
		.footprints,
		.hotspot.object,
		.blanket,
		.easter,
		.sun-easter {
			display: none;
		}

		.hero-copy {
			top: auto;
			bottom: 8%;
			transform: translateX(-50%);
		}

		.hint {
			display: none;
		}
	}
</style>
