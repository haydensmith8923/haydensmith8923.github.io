---
const spots = [
	{
		id: 'chair',
		href: '/about',
		name: 'Beach Chair',
		label: 'About Me',
		sub: 'Where it started',
		style: 'left:38%; bottom:10%;',
	},
	{
		id: 'notebook',
		href: '/journal',
		name: 'Notebook',
		label: 'My Journal',
		sub: 'Notes in progress',
		style: 'left:50%; bottom:16%;',
	},
	{
		id: 'suitcase',
		href: '/investment-banking',
		name: 'Suitcase',
		label: 'Investment Banking',
		sub: 'Where I want to go next',
		style: 'left:60%; bottom:8%;',
	},
	{
		id: 'surfboard',
		href: '/experience',
		name: 'Surfboard',
		label: 'Experience',
		sub: 'What I’ve done so far',
		style: 'left:71%; bottom:11%;',
	},
	{
		id: 'tower',
		href: '/leadership',
		name: 'Lifeguard Tower',
		label: 'Leadership',
		sub: 'Execution under pressure',
		style: 'left:84%; bottom:9%;',
	},
];

// Simple, high-contrast filled glyphs — each built from a distinct silhouette
// (reclining chair vs. boxy case vs. tall A-frame) so objects read clearly at
// a glance instead of relying on thin strokes that blur together.
const ICONS: Record<string, string> = {
	chair: `<svg viewBox="0 0 64 64" fill="currentColor"><rect x="10" y="4" width="9" height="34" rx="2" transform="rotate(28 14.5 21)"/><rect x="11" y="34" width="34" height="7" rx="2"/><rect x="9" y="41" width="5" height="14" rx="1.5"/><rect x="42" y="41" width="5" height="14" rx="1.5"/><rect x="22" y="41" width="5" height="16" rx="1.5" transform="rotate(8 24.5 49)"/></svg>`,
	notebook: `<svg viewBox="0 0 64 64" fill="currentColor"><rect x="14" y="8" width="30" height="48" rx="3"/><g fill="var(--off-white)"><circle cx="14" cy="14" r="1.6"/><circle cx="14" cy="20" r="1.6"/><circle cx="14" cy="26" r="1.6"/><rect x="20" y="20" width="18" height="2.4" rx="1.2"/><rect x="20" y="27" width="18" height="2.4" rx="1.2"/><rect x="20" y="34" width="12" height="2.4" rx="1.2"/></g><rect x="36" y="4" width="4.5" height="26" rx="2" transform="rotate(35 38.25 17)"/></svg>`,
	suitcase: `<svg viewBox="0 0 64 64" fill="currentColor"><path d="M25 14h14a4 4 0 0 1 4 4v4H21v-4a4 4 0 0 1 4-4Z"/><rect x="10" y="22" width="44" height="32" rx="4"/><rect x="26" y="22" width="12" height="6" fill="var(--off-white)"/><rect x="10" y="36" width="44" height="4" fill="var(--off-white)" opacity="0.6"/></svg>`,
	surfboard: `<svg viewBox="0 0 40 90" fill="currentColor"><path d="M20 2c9 14 12 40 8 61-2 10-4 18-8 24-4-6-6-14-8-24-4-21-1-47 8-61Z"/><rect x="19" y="16" width="2" height="60" fill="var(--off-white)" opacity="0.55"/></svg>`,
	tower: `<svg viewBox="0 0 64 90" fill="currentColor"><path d="M14 86 26 30h4l-9 56Z"/><path d="M50 86 38 30h-4l9 56Z"/><rect x="18" y="8" width="28" height="24" rx="2"/><rect x="21" y="12" width="22" height="7" fill="var(--off-white)" opacity="0.6"/><rect x="16" y="58" width="32" height="4" rx="1.5"/><rect x="19" y="44" width="26" height="4" rx="1.5"/></svg>`,
};
---

<section class="scene" data-scene aria-label="Interactive beach photo — explore the site through objects on the shore">
	<picture class="bg-photo">
		<source media="(max-width: 780px)" srcset="/images/beach-hero-mobile.webp" />
		<img
			src="/images/beach-hero.webp"
			alt="Sunset over the ocean, waves rolling onto an open sand beach"
			fetchpriority="high"
		/>
	</picture>
	<div class="scrim" aria-hidden="true"></div>

	<button
		class="hotspot ocean-hotspot"
		data-hotspot
		data-href="/research"
		aria-label="Investment Research — finding what the market may be missing"
	>
		<span class="tooltip">
			<strong>Investment Research</strong>
			<em>Finding what the market may be missing</em>
			<span class="open">Open &rarr;</span>
		</span>
	</button>

	<svg class="footprints" viewBox="0 0 90 140" preserveAspectRatio="xMidYMax meet" data-footprints aria-hidden="true">
		<g fill="currentColor" opacity="0.55">
			<ellipse cx="30" cy="128" rx="6" ry="10" />
			<ellipse cx="48" cy="104" rx="6" ry="10" />
			<ellipse cx="32" cy="80" rx="6" ry="10" />
			<ellipse cx="50" cy="56" rx="6" ry="10" />
			<ellipse cx="34" cy="32" rx="6" ry="10" />
			<ellipse cx="52" cy="8" rx="6" ry="10" />
		</g>
	</svg>

	<button class="easter shell" data-easter="shell" aria-label="A shell on the sand" style="left:93%; bottom:26%;">
		<svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 3c4 2 7 6 7 11a7 7 0 0 1-14 0c0-5 3-9 7-11Z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M12 7v10M9 10l3-2 3 2M8.5 14l3.5-2 3.5 2" fill="none" stroke="currentColor" stroke-width="1"/></svg>
	</button>

	{
		spots.map((s) => (
			<a class={`hotspot object object-${s.id}`} data-hotspot href={s.href} style={s.style} aria-label={`${s.name}: ${s.label} — ${s.sub}`}>
				<span class="badge">
					<Fragment set:html={ICONS[s.id]} />
				</span>
				<span class="caption">{s.name}</span>
				<span class="tooltip">
					<strong>{s.label}</strong>
					<em>{s.sub}</em>
					<span class="open">Open &rarr;</span>
				</span>
			</a>
		))
	}

	<button class="easter sun-easter" data-easter="sun" aria-label="The sunset" style="left:62%; top:37%;"></button>

	<div class="hero-copy">
		<p class="kicker">From the Gulf Coast to Wall Street</p>
		<h1>HAYDEN SMITH</h1>
		<p class="sub">Carnegie Mellon University &middot; Business Administration</p>
		<p class="tag">From Florida to finance.</p>
		<p class="hint" data-hint>Explore the shore to begin.</p>
	</div>

	<div class="easter-popover" data-easter-popover hidden>
		<button class="close" data-easter-close aria-label="Close">&times;</button>
		<p data-easter-text></p>
	</div>
</section>

<script define:vars={{
	shellText: "I'm a twin — there's always been two of us telling this story.",
	sunText: "“Good days and bad days can happen simultaneously. Show up for both.”",
}}>
	const popover = document.querySelector('[data-easter-popover]');
	const popoverText = document.querySelector('[data-easter-text]');
	const closeBtn = document.querySelector('[data-easter-close]');
	const hint = document.querySelector('[data-hint]');

	const texts = { shell: shellText, sun: sunText };

	document.querySelectorAll('[data-easter]').forEach((el) => {
		el.addEventListener('click', () => {
			const key = el.getAttribute('data-easter');
			if (!popover || !popoverText) return;
			popoverText.textContent = texts[key] || '';
			popover.hidden = false;
		});
	});

	closeBtn?.addEventListener('click', () => {
		if (popover) popover.hidden = true;
	});

	let hovered = false;
	document.querySelectorAll('[data-hotspot]').forEach((el) => {
		el.addEventListener('mouseenter', () => {
			if (!hovered) {
				hovered = true;
				hint?.classList.add('is-hidden');
			}
		});
	});
</script>

<style>
	.scene {
		position: relative;
		width: 100%;
		height: 100svh;
		min-height: 560px;
		overflow: hidden;
		background: var(--navy-deep);
	}

	.bg-photo,
	.bg-photo img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.bg-photo img {
		object-fit: cover;
		object-position: center 60%;
	}

	.scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(8, 14, 24, 0.6) 0%,
			rgba(8, 14, 24, 0.18) 26%,
			rgba(8, 14, 24, 0.02) 46%,
			rgba(8, 14, 24, 0.16) 72%,
			rgba(8, 14, 24, 0.5) 100%
		);
	}

	.ocean-hotspot {
		position: absolute;
		left: 0;
		right: 0;
		top: 16%;
		height: 42%;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 2;
	}

	.footprints {
		position: absolute;
		left: 30%;
		bottom: 0;
		width: 22%;
		height: 42%;
		color: var(--wood);
		z-index: 2;
	}

	.hotspot {
		position: absolute;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: var(--off-white);
		transition: transform 0.35s var(--ease);
		text-decoration: none;
		z-index: 3;
	}

	.hotspot.object {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		transform: translate(-50%, 50%);
	}

	.badge {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: rgba(250, 247, 240, 0.92);
		box-shadow: 0 8px 20px rgba(8, 14, 24, 0.35), inset 0 0 0 1px rgba(23, 21, 18, 0.08);
		color: var(--navy-deep);
		transition: transform 0.35s var(--ease), background 0.35s ease;
	}

	.badge svg {
		width: auto;
		height: auto;
		max-width: 30px;
		max-height: 30px;
	}

	.object-tower .badge svg,
	.object-surfboard .badge svg {
		max-height: 36px;
	}

	.caption {
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--off-white);
		background: rgba(8, 14, 24, 0.55);
		padding: 0.25em 0.7em;
		border-radius: 999px;
		white-space: nowrap;
	}

	.hotspot.object:hover,
	.hotspot.object:focus-visible {
		transform: translate(-50%, 50%) translateY(-4px);
	}

	.hotspot.object:hover .badge,
	.hotspot.object:focus-visible .badge {
		background: var(--off-white);
		transform: scale(1.08);
	}

	.hotspot:focus-visible {
		outline: 2px solid var(--sunset);
		outline-offset: 4px;
	}

	.tooltip {
		position: absolute;
		left: 50%;
		bottom: calc(100% + 12px);
		transform: translate(-50%, 6px);
		background: rgba(11, 31, 51, 0.94);
		color: var(--off-white);
		padding: 0.7rem 1rem;
		min-width: 172px;
		text-align: left;
		font-family: var(--font-body);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease, transform 0.25s ease;
		white-space: nowrap;
	}

	.tooltip strong {
		display: block;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 600;
		margin-bottom: 0.15rem;
	}

	.tooltip em {
		display: block;
		font-style: normal;
		font-size: 0.72rem;
		color: var(--sand);
		letter-spacing: 0.02em;
	}

	.tooltip .open {
		display: block;
		margin-top: 0.4rem;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sunset);
	}

	.hotspot:hover .tooltip,
	.hotspot:focus-visible .tooltip {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.ocean-hotspot .tooltip {
		left: 50%;
		bottom: auto;
		top: 50%;
		transform: translate(-50%, -40%);
	}

	.ocean-hotspot:hover .tooltip,
	.ocean-hotspot:focus-visible .tooltip {
		transform: translate(-50%, -50%);
	}

	.easter {
		position: absolute;
		background: none;
		border: none;
		cursor: pointer;
		color: rgba(250, 247, 240, 0.75);
		z-index: 3;
		min-width: 44px;
		min-height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.easter:hover {
		color: var(--sunset);
	}

	.sun-easter {
		width: 90px;
		height: 90px;
		border-radius: 50%;
		transform: translate(-50%, -50%);
		min-width: 0;
		min-height: 0;
	}

	.hero-copy {
		position: absolute;
		left: 50%;
		top: 30%;
		transform: translate(-50%, -50%);
		text-align: center;
		color: var(--off-white);
		z-index: 4;
		width: 100%;
		padding: 0 1.5rem;
	}

	.kicker {
		text-transform: uppercase;
		letter-spacing: 0.22em;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--sand);
		margin: 0 0 1.1rem;
	}

	.hero-copy h1 {
		font-size: clamp(2.4rem, 8vw, 5rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		margin: 0 0 0.5rem;
		text-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
	}

	.sub {
		font-size: clamp(0.95rem, 2vw, 1.15rem);
		color: var(--off-white);
		margin: 0 0 0.4rem;
		font-weight: 500;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
	}

	.tag {
		font-family: var(--font-display);
		font-style: italic;
		font-size: clamp(1rem, 2.2vw, 1.25rem);
		color: var(--sand);
		margin: 0;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
	}

	.hint {
		margin: 2.2rem 0 0;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: rgba(250, 247, 240, 0.75);
		transition: opacity 0.4s ease;
	}

	.hint.is-hidden {
		opacity: 0;
	}

	.easter-popover {
		position: absolute;
		left: 50%;
		bottom: 8%;
		transform: translateX(-50%);
		max-width: 360px;
		background: var(--off-white);
		color: var(--navy-deep);
		padding: 1.2rem 1.4rem;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
		z-index: 10;
	}

	.easter-popover p {
		margin: 0;
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1rem;
		padding-right: 1.2rem;
	}

	.easter-popover .close {
		position: absolute;
		top: 0.4rem;
		right: 0.6rem;
		background: none;
		border: none;
		font-size: 1.2rem;
		cursor: pointer;
		color: var(--navy-deep);
	}

	@media (max-width: 780px) {
		.scene {
			height: 70vh;
			min-height: 420px;
		}

		.ocean-hotspot,
		.footprints,
		.hotspot.object,
		.easter,
		.sun-easter {
			display: none;
		}

		.hero-copy {
			top: auto;
			bottom: 8%;
			transform: translateX(-50%);
		}

		.hint {
			display: none;
		}
	}
</style>
