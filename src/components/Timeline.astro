---
import { getCollection, render } from 'astro:content';
import TimelineItem from './TimelineItem.astro';

const entries = await getCollection('timeline');
entries.sort((a, b) => a.data.order - b.data.order);

const items = await Promise.all(
	entries.map(async (entry, index) => {
		const { Content } = await render(entry);
		return { entry, index, Content };
	})
);
---

<div class="timeline" data-timeline>
	{
		items.map(({ entry, index, Content }) => (
			<TimelineItem year={entry.data.year} title={entry.data.title} index={index}>
				<Content />
			</TimelineItem>
		))
	}
</div>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const timeline = document.querySelector('[data-timeline]');
	const items = document.querySelectorAll('[data-timeline-item]');

	if (!reduceMotion && timeline) {
		// Opt into the hidden-until-scrolled-into-view state only when JS
		// and motion are both available — content stays visible otherwise.
		timeline.classList.add('js-reveal');

		const reveal = (item) => {
			item.classList.add('is-visible');
			item.querySelectorAll('mark').forEach((m) => m.classList.add('is-visible'));
		};

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						reveal(entry.target);
						observer.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0, rootMargin: '0px 0px 150px 0px' }
		);

		for (const item of items) observer.observe(item);

		// Safety net: guarantee everything above is revealed by the time
		// the reader reaches the bottom, regardless of observer timing.
		const revealPastItems = () => {
			const cutoff = window.scrollY + window.innerHeight;
			items.forEach((item) => {
				if (item.offsetTop < cutoff) reveal(item);
			});
		};
		document.addEventListener('scroll', revealPastItems, { passive: true });
		window.addEventListener('load', revealPastItems);
	} else {
		// No animation path: mark everything visible immediately.
		items.forEach((item) => {
			item.classList.add('is-visible');
			item.querySelectorAll('mark').forEach((m) => m.classList.add('is-visible'));
		});
	}
</script>
