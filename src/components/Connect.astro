---
const links = [
	{ label: 'LinkedIn', value: 'in/hayden-smith29', href: 'https://www.linkedin.com/in/hayden-smith29' },
	{ label: 'Email', value: 'haydensmith8923@gmail.com', href: 'mailto:haydensmith8923@gmail.com' },
	{ label: 'Résumé', value: 'View PDF', href: '/resume' },
];
---

<section class="connect wrap-wide">
	<p class="eyebrow">Connect</p>
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
						<span class="label">{link.label}</span>
						<span class="value">{link.value} &rarr;</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.connect {
		padding-block: 3rem 4rem;
		border-top: 1px solid var(--line);
		margin-top: 3rem;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 1.2rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 2.5rem;
	}

	a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		text-decoration: none;
		color: var(--fg);
	}

	.label {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.15rem;
	}

	.value {
		font-size: 0.85rem;
		color: var(--ocean);
	}

	a:hover .value {
		color: var(--sunset-deep);
	}
</style>
